# Settings for borg-docker's setup.sh and retention.sh.
#
# Copy this to borg-docker.env beside the scripts, or pass it with --env, and
# fill in your own values. The file is sourced by bash, so quote every value.
# It is the one place your own addresses and paths live, so keep it out of
# version control: the repository's .gitignore already ignores
# borg-docker.env beside the scripts.
#
# Leave out anything you are happy with the default for. A variable set in
# the environment when a script runs takes precedence over this file.

# Read by setup.sh, on each client:

# The Borg server's address. Required; setup.sh asks if it is missing.
SERVER_HOST="backup.example.lan"

# The SSH port the server listens on (default 22). The borgserver image
# listens on 22 inside the container; this is the host port it is mapped to.
SERVER_PORT="2222"

# The SSH user on the server (default borg, which is what borgserver uses).
#SERVER_USER="borg"

# The name of the SSH config alias written to /root/.ssh/config, and the
# host part of the repository URL (default borg-server).
#SSH_ALIAS="borg-server"

# The repository's directory under /backup/<client>/ (default containers).
#REPO_NAME="containers"

# The full repository path on the server, for a server that is not laid out
# the way borgserver lays it out. Default /backup/<client>/<REPO_NAME>.
#REPO_PATH="/backup/myhost/containers"

# When the daily backup starts, as HH:MM (default 03:30). Up to 15 minutes of
# jitter is added.
#BACKUP_TIME="03:30"

# Where client keys go on the server, and who should own them. Used only in
# the instructions setup.sh prints when a key needs adding.
#SERVER_KEYS_DIR="/srv/borg/sshkeys/clients"
#SERVER_KEY_OWNER="1000:1000"

# These are per host and are remembered on each host after the first run, so
# they rarely belong in a file shared between hosts:
#   CLIENT_NAME    (default: the short host name)
#   PROJECTS_DIR   (default: found from Arcane, else /opt/arcane/projects)
#   VOLUMES_DIR    (default: from docker info)
#   EXTRA_DIRS, SKIP_DIRS, BORG_EXCLUDES, KEPT_VOLUMES
#   LARGE_VOLUME_MB (default 1024: larger volumes are asked about once)

# Read by both scripts:

# The borgserver container's name (default borgserver).
#BORGSERVER_CONTAINER="borgserver"

# Read by retention.sh, on the server:

# A root-only directory holding <client>.pass, one passphrase per client.
# Required by retention.sh.
RETENTION_PASSDIR="/srv/borg/.retention"

# The borg prune keep rules (default below).
#RETENTION_KEEP="--keep-daily 14 --keep-weekly 8 --keep-monthly 6"
